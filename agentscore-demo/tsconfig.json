{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tricentis/aura/*": ["../Tricentis/aura-ui/*"],
      "@tricentis/mui-icons/*": ["../Tricentis/aura-ui/node_modules/@tricentis/mui-icons/*"]
    }
  },
  "include": ["src"]
}
